{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "usermeta": {
    "chapter": 4,
    "advanced": false,
    "idiom": "Multi-line chart",
    "data": ["data/aims_ltmp_reef_year.csv"]
  },
  "title": {
    "text": "Hard coral cover has risen and fallen over four decades",
    "subtitle": "Mean hard coral cover by sector and year (AIMS Long-term Monitoring Program)."
  },
  "width": 960,
  "height": 420,
  "data": {
    "url": "data/aims_ltmp_reef_year.csv",
    "format": { "type": "csv", "parse": { "year": "number", "hard_coral": "number", "hard_coral_lower": "number", "hard_coral_upper": "number", "lat": "number", "lon": "number" } }
  },
  "params": [
    { "name": "sector_hl", "select": { "type": "point", "fields": ["sector"] }, "bind": "legend" }
  ],
  "transform": [
    { "aggregate": [{ "op": "mean", "field": "hard_coral", "as": "cover" }], "groupby": ["sector", "year"] }
  ],
  "mark": { "type": "line", "strokeWidth": 2, "point": { "size": 28 } },
  "encoding": {
    "x": { "field": "year", "type": "quantitative", "title": null, "axis": { "format": "d" }, "scale": { "zero": false } },
    "y": { "field": "cover", "type": "quantitative", "title": "Mean hard coral cover (%)", "scale": { "zero": true } },
    "color": { "field": "sector", "type": "nominal", "title": "Sector (north to south)", "scale": { "scheme": "tableau20", "domain": ["Torres Strait", "Cape Grenville", "Princess Charlotte Bay", "Cooktown-Lizard Island", "Cairns", "Innisfail", "Townsville", "Cape Upstart", "Whitsunday", "Pompey", "Swain", "Capricorn-Bunker"] } },
    "opacity": { "condition": { "param": "sector_hl", "value": 1 }, "value": 0.15 },
    "tooltip": [
      { "field": "sector", "type": "nominal", "title": "Sector" },
      { "field": "year", "type": "quantitative", "title": "Year", "format": "d" },
      { "field": "cover", "type": "quantitative", "title": "Mean hard coral cover (%)", "format": ".1f" }
    ]
  }
}
