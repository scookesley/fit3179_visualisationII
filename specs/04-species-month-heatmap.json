{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "usermeta": {
    "chapter": 2,
    "advanced": true,
    "idiom": "Heatmap (rect marks) with per-species normalisation",
    "data": ["data/ala_occurrences.csv"]
  },
  "title": {
    "text": "When is each species seen?",
    "subtitle": ["Share of each species' busiest month by calendar month."]
  },
  "width": "container",
  "height": 300,
  "data": { "url": "data/ala_occurrences.csv", "format": { "type": "csv", "parse": { "month": "number" } } },
  "transform": [
    { "filter": "isValid(datum.month)" },
    { "aggregate": [{ "op": "count", "as": "n" }], "groupby": ["species", "month"] },
    { "joinaggregate": [{ "op": "max", "field": "n", "as": "peak" }], "groupby": ["species"] },
    { "calculate": "datum.n / datum.peak", "as": "relative" }
  ],
  "mark": { "type": "rect", "stroke": "#ffffff", "strokeWidth": 1 },
  "encoding": {
    "x": {
      "field": "month",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelAngle": 0,
        "labelExpr": "['J','F','M','A','M','J','J','A','S','O','N','D'][datum.value - 1]"
      }
    },
    "y": { "field": "species", "type": "nominal", "title": null },
    "color": {
      "field": "relative",
      "type": "quantitative",
      "title": "Share of peak month",
      "scale": { "scheme": "teals", "domain": [0, 1] },
      "legend": { "format": "%", "orient": "bottom" }
    },
    "tooltip": [
      { "field": "species", "type": "nominal", "title": "Species" },
      { "field": "month", "type": "ordinal", "title": "Month" },
      { "field": "n", "type": "quantitative", "title": "Records" },
      { "field": "relative", "type": "quantitative", "title": "Share of peak", "format": ".0%" }
    ]
  }
}
