{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "usermeta": {
    "chapter": 1,
    "advanced": true,
    "idiom": "Proportional symbol map",
    "data": [
      "data/aus_states.geojson",
      "data/australian_marine_parks.geojson",
      "data/park_summary.csv"
    ]
  },
  "title": {
    "text": ["Australian Marine Parks receive a formal International Union for Conservation of Nature", "(IUCN) protection rating"],
    "subtitle": [
      "Each circle is a marine park: size = park area, colour = share of the park in the strictest zones (IUCN Ia/II)."
    ],
    "offset":40
  },
  "width": 800,
  "height": 560,
  "autosize": "none",
  "padding": { "left": 10, "right": 10, "top": 90, "bottom": 110 },
  "projection": {
    "type": "mercator",
    "center": [
      120,
      -36
    ],
    "scale": 430
  },
  "layer": [
    {
      "data": {
        "graticule": {
          "step": [
            20,
            20
          ]
        }
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#dde3e6",
        "strokeWidth": 0.6
      }
    },
    {
      "data": {
        "url": "data/aus_states.geojson",
        "format": {
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eceae3",
        "stroke": "#c9c6bc",
        "strokeWidth": 0.4
      }
    },
    {
      "data": {
        "url": "data/australian_marine_parks.geojson",
        "format": {
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": null
      }
    },
    {
      "data": {
        "values": [
          { "lon": 96.9,   "lat": -22.1, "lon2": 96.9,  "lat2": -15.5 },
          { "lon": 100.68, "lat": -22.1, "lon2": 104.7, "lat2": -14.3 }
        ]
      },
      "mark": { "type": "rule", "stroke": "#333", "strokeWidth": 1 },
      "encoding": {
        "longitude": { "field": "lon", "type": "quantitative" },
        "latitude": { "field": "lat", "type": "quantitative" },
        "longitude2": { "field": "lon2" },
        "latitude2": { "field": "lat2" }
      }
    },
    {
      "data": {
        "url": "data/park_summary.csv",
        "format": {
          "parse": {
            "lon": "number",
            "lat": "number",
            "total_km2": "number",
            "strict_km2": "number",
            "pct_strict": "number",
            "n_zones": "number"
          }
        }
      },
      "mark": {
        "type": "circle",
        "opacity": 0.80,
        "stroke": "#0b2e3f",
        "strokeWidth": 0.9
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "total_km2",
          "type": "quantitative",
          "title": "Park area (km²)",
          "scale": {
            "type": "linear",
            "zero": true,
            "range": [
              50,
              6500
            ]
          },
          "legend": {
            "values": [
              10000,
              100000,
              500000,
              1000000
            ],
            "format": "~s",
            "orient": "bottom",
            "symbolFillColor": "#ffffff",
            "offset": 4
          }
        },
        "color": {
          "field": "pct_strict",
          "type": "quantitative",
          "title": "Share in strictest zones",
          "scale": {
            "scheme": "teals",
            "domain": [
              0,
              100
            ]
          },
          "legend": {
            "orient": "bottom",
            "gradientLength": 120,
            "labelExpr": "datum.value + '%'",
            "offset": 4
          }
        },
        "order": {
          "field": "total_km2",
          "type": "quantitative",
          "sort": "descending"
        },
        "tooltip": [
          {
            "field": "park",
            "type": "nominal",
            "title": "Park"
          },
          {
            "field": "network",
            "type": "nominal",
            "title": "Network"
          },
          {
            "field": "total_km2",
            "type": "quantitative",
            "title": "Area (km²)",
            "format": ",.0f"
          },
          {
            "field": "pct_strict",
            "type": "quantitative",
            "title": "In strictest zones (%)",
            "format": ".1f"
          },
          {
            "field": "n_zones",
            "type": "quantitative",
            "title": "Zones"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/park_summary.csv",
        "format": {
          "parse": {
            "lon": "number", "lat": "number", "total_km2": "number",
            "strict_km2": "number", "pct_strict": "number", "n_zones": "number"
          }
        }
      },
      "transform": [
        { "window": [{ "op": "rank", "as": "rnk" }], "sort": [{ "field": "total_km2", "order": "descending" }] },
        { "filter": "datum.rnk <= 7" },
        {
          "calculate": "datum.park === 'Heard Island and McDonald Islands' ? 'Heard & McDonald Is.' : (datum.park === 'Cocos (Keeling) Islands' ? 'Cocos (Keeling) Is.' : datum.park)",
          "as": "label"
        },
        {
          "calculate": "datum.park === 'Cocos (Keeling) Islands' ? 'left' : (datum.park === 'South-west Corner' ? 'below' : (datum.park === 'Heard Island and McDonald Islands' ? 'above-left' : 'above'))",
          "as": "pos"
        },
        {
          "calculate": "datum.park === 'Coral Sea' ? 39 : (datum.park === 'Cocos (Keeling) Islands' ? 27 : (datum.park === 'Macquarie Island' ? 27 : (datum.park === 'Heard Island and McDonald Islands' ? 24.5 : (datum.park === 'Christmas Island' ? 21 : (datum.park === 'South-west Corner' ? 20.5 : 17.5)))))",
          "as": "r"
        },
        {
          "calculate": "datum.lat + (datum.pos === 'below' ? -1 : (datum.pos === 'left' ? 0 : 1)) * (datum.r + 6) * cos(datum.lat * PI / 180) / 7.5049",
          "as": "lat_lbl"
        },
        {
          "calculate": "datum.lon - (datum.pos === 'left' ? (datum.r + 6) / 7.5049 : (datum.pos === 'above-left' ? datum.r / 7.5049 : 0))",
          "as": "lon_lbl"
        }
      ],
      "encoding": {
        "longitude": { "field": "lon_lbl", "type": "quantitative" },
        "latitude": { "field": "lat_lbl", "type": "quantitative" },
        "text": { "field": "label", "type": "nominal" }
      },
      "layer": [
        {
          "transform": [{ "filter": "datum.pos === 'above'" }],
          "layer": [
            { "mark": { "type": "text", "align": "center", "baseline": "bottom", "fontSize": 11, "fontWeight": 600, "color": "#fff", "stroke": "#fff", "strokeWidth": 3, "strokeJoin": "round", "strokeOpacity": 0.9 } },
            { "mark": { "type": "text", "align": "center", "baseline": "bottom", "fontSize": 11, "fontWeight": 600, "color": "#0b2e3f" } }
          ]
        },
        {
          "transform": [{ "filter": "datum.pos === 'below'" }],
          "layer": [
            { "mark": { "type": "text", "align": "center", "baseline": "top", "fontSize": 11, "fontWeight": 600, "color": "#fff", "stroke": "#fff", "strokeWidth": 3, "strokeJoin": "round", "strokeOpacity": 0.9 } },
            { "mark": { "type": "text", "align": "center", "baseline": "top", "fontSize": 11, "fontWeight": 600, "color": "#0b2e3f" } }
          ]
        },
        {
          "transform": [{ "filter": "datum.pos === 'left'" }],
          "layer": [
            { "mark": { "type": "text", "align": "right", "baseline": "middle", "fontSize": 11, "fontWeight": 600, "color": "#fff", "stroke": "#fff", "strokeWidth": 3, "strokeJoin": "round", "strokeOpacity": 0.9 } },
            { "mark": { "type": "text", "align": "right", "baseline": "middle", "fontSize": 11, "fontWeight": 600, "color": "#0b2e3f" } }
          ]
        },
        {
          "transform": [{ "filter": "datum.pos === 'above-left'" }],
          "layer": [
            { "mark": { "type": "text", "align": "left", "baseline": "bottom", "fontSize": 11, "fontWeight": 600, "color": "#fff", "stroke": "#fff", "strokeWidth": 3, "strokeJoin": "round", "strokeOpacity": 0.9 } },
            { "mark": { "type": "text", "align": "left", "baseline": "bottom", "fontSize": 11, "fontWeight": 600, "color": "#0b2e3f" } }
          ]
        }
      ]
    }
  ]
}