{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "usermeta": {
    "chapter": 1,
    "advanced": true,
    "idiom": "Map: categorical polygons, zoomed on the GBR",
    "data": ["data/aus_states.geojson", "data/gbr_zoning.geojson"]
  },
  "title": {
    "text": ["The Great Barrier Reef  is zoned", "by how much activity is allowed"],
    "subtitle": "Marine Park zones",
    "offset" : 20
  },
  "width": 400,
  "height": 535,
  "padding": { "left": 0, "right": 0, "top": 80, "bottom": 0 },
  "autosize": "none",
  "projection": { "type": "mercator", "center": [148.2, -17.6], "scale": 1800 },
  "layer": [
    {
      "data": { "url": "data/aus_states.geojson", "format": { "property": "features" } },
      "mark": { "type": "geoshape", "fill": "#eceae3", "stroke": "#c9c6bc", "strokeWidth": 0.4 }
    },
    {
      "data": { "url": "data/gbr_zoning.geojson", "format": { "property": "features" } },
      "mark": { "type": "geoshape", "stroke": "#ffffff", "strokeWidth": 0.15 },
      "encoding": {
        "color": {
          "field": "properties.TYPE",
          "type": "nominal",
          "title": "Zone",
          "legend": {
            "orient": "top-right",
            "offset": 0,
            "symbolType": "square",
            "values": [
              "Preservation",
              "Scientific Research",
              "Marine National Park",
              "Buffer",
              "Conservation Park",
              "Habitat Protection",
              "General Use",
              "Commonwealth Islands (GBRMPA)"
            ],
            "labelExpr": "datum.value === 'Commonwealth Islands (GBRMPA)' ? 'Commonwealth Islands' : datum.value"
          },
          "scale": {
            "domain": [
              "Preservation",
              "Scientific Research",
              "Scientific Research (closed to public access)",
              "Marine National Park",
              "Buffer",
              "Conservation Park",
              "Habitat Protection",
              "General Use",
              "Commonwealth Islands (GBRMPA)",
              "Commonwealth Islands (Other)"
            ],
            "range": ["#e07aa5", "#e8913a", "#e8913a", "#4a9d5b", "#8a9a3b", "#f4d35e", "#2a6fb0", "#9fd4ee", "#bdbdbd", "#bdbdbd"]
          }
        },
        "tooltip": [{ "field": "properties.TYPE", "type": "nominal", "title": "Zone" }]
      }
    },
    {
      "data": { "values": [
        { "town": "Cooktown",     "lon": 145.25, "lat": -15.47 },
        { "town": "Cairns",       "lon": 145.77, "lat": -16.92 },
        { "town": "Townsville",   "lon": 146.82, "lat": -19.26 },
        { "town": "Airlie Beach", "lon": 148.72, "lat": -20.27 },
        { "town": "Mackay",       "lon": 149.19, "lat": -21.14 },
        { "town": "Rockhampton",  "lon": 150.51, "lat": -23.38 },
        { "town": "Gladstone",    "lon": 151.26, "lat": -23.85 },
        { "town": "Bundaberg",    "lon": 152.35, "lat": -24.87 },
        { "town": "Brisbane",     "lon": 153.03, "lat": -27.47 },
        { "town": "Gold Coast",   "lon": 153.40, "lat": -28.02 }
      ] },
      "layer": [
        { "mark": { "type": "point", "filled": true, "size": 30, "color": "#0b2e3f", "stroke": "#ffffff", "strokeWidth": 1 } },
        { "mark": { "type": "text", "align": "right", "baseline": "middle", "dx": -6, "fontSize": 11, "fontWeight": 600, "color": "#fff", "stroke": "#fff", "strokeWidth": 3, "strokeJoin": "round", "strokeOpacity": 0.9 },
          "encoding": { "text": { "field": "town", "type": "nominal" } } },
        { "mark": { "type": "text", "align": "right", "baseline": "middle", "dx": -6, "fontSize": 11, "fontWeight": 600, "color": "#0b2e3f" },
          "encoding": { "text": { "field": "town", "type": "nominal" } } }
      ],
      "encoding": {
        "longitude": { "field": "lon", "type": "quantitative" },
        "latitude": { "field": "lat", "type": "quantitative" }
      }
    }
  ]
}
