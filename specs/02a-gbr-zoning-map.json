{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "usermeta": {
    "chapter": 1,
    "advanced": true,
    "idiom": "Map: categorical polygons, zoomed on the GBR",
    "data": ["data/aus_states.geojson", "data/gbr_zoning.geojson"]
  },
  "title": {
    "text": ["The Great Barrier Reef Marine Park is", "zoned by how much activity is allowed"],
    "subtitle": "Marine Park zones"
  },
  "width": "container",
  "height": 600,
  "projection": { "type": "mercator", "center": [148.2, -17.6], "scale": { "expr": "min(width * 4.6, height * 3.3)" } },
  "layer": [
    {
      "data": { "url": "data/aus_states.geojson", "format": { "property": "features" } },
      "mark": { "type": "geoshape", "fill": "#eceae3", "stroke": "#c9c6bc", "strokeWidth": 0.4 }
    },
    {
      "data": { "url": "data/gbr_zoning.geojson", "format": { "property": "features" } },
      "mark": { "type": "geoshape", "stroke": "#ffffff", "strokeWidth": 0.15 },
      "encoding": {
        "color": {
          "field": "properties.TYPE",
          "type": "nominal",
          "title": "Zone",
          "legend": { "orient": "right", "columns": 1, "labelLimit": 320 },
          "scale": {
            "domain": [
              "General Use",
              "Habitat Protection",
              "Conservation Park",
              "Buffer",
              "Scientific Research",
              "Scientific Research (closed to public access)",
              "Marine National Park",
              "Preservation",
              "Commonwealth Islands (GBRMPA)",
              "Commonwealth Islands (Other)"
            ],
            "range": ["#9fd4ee", "#2a6fb0", "#f4d35e", "#8a9a3b", "#e8913a", "#e8913a", "#4a9d5b", "#e07aa5", "#bdbdbd", "#bdbdbd"]
          }
        },
        "tooltip": [{ "field": "properties.TYPE", "type": "nominal", "title": "Zone" }]
      }
    }
  ]
}
