{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "usermeta": {
    "chapter": 3,
    "advanced": true,
    "idiom": "Map: choropleth with a lookup join",
    "data": ["data/aus_states.geojson", "data/threatened_marine_by_state.csv"]
  },
  "title": {
    "text": "Threatened marine species by state and territory",
    "subtitle": ["EPBC-listed threatened species found in Commonwealth waters, counted", "in each jurisdiction where they are present. A species can count in more than one."]
  },
  "width": "container",
  "height": 600,
  "projection": { "type": "mercator", "center": [134, -28], "scale": { "expr": "min(width, height) * 1.3" } },
  "data": { "url": "data/aus_states.geojson", "format": { "property": "features" } },
  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": { "url": "data/threatened_marine_by_state.csv", "format": { "type": "csv", "parse": { "n_species": "number" } } },
        "key": "state",
        "fields": ["n_species"]
      }
    }
  ],
  "mark": { "type": "geoshape", "stroke": "#ffffff", "strokeWidth": 0.8 },
  "encoding": {
    "color": {
      "field": "n_species",
      "type": "quantitative",
      "title": "Threatened marine species",
      "scale": { "scheme": "oranges" },
      "legend": { "orient": "bottom" }
    },
    "tooltip": [
      { "field": "properties.STATE_NAME", "type": "nominal", "title": "State" },
      { "field": "n_species", "type": "quantitative", "title": "Threatened marine species" }
    ]
  },
  "config": { "mark": { "invalid": null } }
}
