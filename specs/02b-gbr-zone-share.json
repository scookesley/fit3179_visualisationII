{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "usermeta": {
    "chapter": 1,
    "advanced": true,
    "idiom": "Normalised stacked bar",
    "data": ["data/gbr_zoning.geojson"]
  },
  "title": {
    "text": ["GBR Marine Park:", "Total zone composition"],
    "subtitle": "Share of total zoned area by zone",
    "offset" : 20
  },
  "width": 300,
  "height": 540,
  "padding": { "left": 0, "right": 0, "top": 5, "bottom": 0 },
  "autosize": { "type": "fit-x", "contains": "padding" },
  "data": {
    "values": [
      { "rank": 1, "zone": "General Use",          "area_km2": 116858 },
      { "rank": 2, "zone": "Marine National Park", "area_km2": 114597 },
      { "rank": 3, "zone": "Habitat Protection",   "area_km2": 97575 },
      { "rank": 4, "zone": "Buffer",               "area_km2": 9915 },
      { "rank": 5, "zone": "Conservation Park",    "area_km2": 5155 },
      { "rank": 6, "zone": "Other (<1%)",          "area_km2": 970 }
    ]
  },
  "transform": [
    { "joinaggregate": [{ "op": "sum", "field": "area_km2", "as": "total" }] },
    { "calculate": "datum.area_km2 / datum.total", "as": "pct" },
    { "window": [{ "op": "sum", "field": "pct", "as": "cum" }], "sort": [{ "field": "rank", "order": "ascending" }], "frame": [null, 0] },
    { "calculate": "datum.cum - datum.pct", "as": "bottom" },
    { "calculate": "datum.cum", "as": "top" },
    { "calculate": "datum.cum - datum.pct / 2", "as": "mid" }
  ],
  "layer": [
    {
      "mark": { "type": "bar", "stroke": "#ffffff", "strokeWidth": 0.8 },
      "encoding": {
        "y": {
          "field": "bottom", "type": "quantitative", "title": null,
          "scale": { "domain": [0, 1], "nice": false },
          "axis": { "format": "%", "values": [0, 0.25, 0.5, 0.75, 1] }
        },
        "y2": { "field": "top" },
        "color": {
          "field": "zone", "type": "nominal", "title": "Zone",
          "scale": {
            "domain": ["Other (<1%)", "Conservation Park", "Buffer", "Habitat Protection", "Marine National Park", "General Use"],
            "range":  ["#3c280d", "#f4d35e", "#8a9a3b", "#2a6fb0", "#4a9d5b", "#9fd4ee"]
          },
          "legend": {
            "orient": "right", "symbolType": "square", "labelLimit": 260,
            "values": [
              "Other (<1%)",
              "Conservation Park",
              "Buffer",
              "Habitat Protection",
              "Marine National Park",
              "General Use"
            ]
          }
        },
        "tooltip": [
          { "field": "zone", "type": "nominal", "title": "Zone" },
          { "field": "area_km2", "type": "quantitative", "title": "Area (km²)", "format": ",.0f" },
          { "field": "pct", "type": "quantitative", "title": "Share of park", "format": ".1%" }
        ]
      }
    },
    {
      "transform": [{ "filter": "datum.pct >= 0.08" }],
      "mark": { "type": "text", "fontSize": 12, "fontWeight": 600 },
      "encoding": {
        "y": { "field": "mid", "type": "quantitative", "axis": null, "scale": { "domain": [0, 1], "nice": false } },
        "text": { "field": "pct", "type": "quantitative", "format": ".0%" },
        "color": { "condition": { "test": "datum.zone === 'General Use'", "value": "#0b2e3f" }, "value": "#ffffff" }
      }
    }
  ]
}