{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "usermeta": {
    "chapter": 3,
    "advanced": false,
    "idiom": "Stacked bar",
    "data": ["data/threatened_marine_by_group.csv"]
  },
  "title": {
    "text": "Birds make up 50 of the 83 threatened species in Commonwealth waters",
    "subtitle": "EPBC-listed threatened species recorded in the Commonwealth Marine Area, by group and threat category."
  },
  "width": 720,
  "height": 380,
  "data": { "url": "data/threatened_marine_by_group.csv", "format": { "type": "csv", "parse": { "n": "number" } } },
  "mark": { "type": "bar", "stroke": "#ffffff", "strokeWidth": 0.6 },
  "encoding": {
    "x": { "field": "group", "type": "nominal", "title": null, "sort": "-y", "axis": { "labelAngle": 0 } },
    "y": { "field": "n", "type": "quantitative", "aggregate": "sum", "title": "Number of species" },
    "color": {
      "field": "status",
      "type": "nominal",
      "title": "Threat category",
      "scale": {
        "domain": ["Vulnerable", "Endangered", "Critically Endangered"],
        "range": ["#f2cc8f", "#e07a5f", "#8c2d19"]
      }
    },
    "order": { "field": "status", "type": "nominal", "sort": "ascending" },
    "tooltip": [
      { "field": "group", "type": "nominal", "title": "Group" },
      { "field": "status", "type": "nominal", "title": "Category" },
      { "field": "n", "type": "quantitative", "title": "Species" }
    ]
  }
}
