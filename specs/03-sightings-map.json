{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "usermeta": {
    "chapter": 2,
    "advanced": true,
    "idiom": "Map: binned density grid over marine park outlines",
    "data": ["data/aus_states.geojson", "data/australian_marine_parks.geojson", "data/ala_occurrences.csv"]
  },
  "title": {
    "text": "Locations across Australia of reported sightings",
    "subtitle": "Records per 0.5° cell (Atlas of Living Australia)"
  },
  "width": 900,
  "height": 820,
  "params": [{ "name": "species_sel", "value": "Humpback Whale" }],
  "datasets": {
    "capitals": [
      { "city": "Perth",     "lon": 115.86, "lat": -31.95, "pos": "right" },
      { "city": "Adelaide",  "lon": 138.60, "lat": -34.93, "pos": "above" },
      { "city": "Melbourne", "lon": 144.96, "lat": -37.81, "pos": "above" },
      { "city": "Hobart",    "lon": 147.33, "lat": -42.88, "pos": "left" },
      { "city": "Canberra",  "lon": 149.13, "lat": -35.28, "pos": "left" },
      { "city": "Sydney",    "lon": 151.21, "lat": -33.87, "pos": "left" },
      { "city": "Brisbane",  "lon": 153.03, "lat": -27.47, "pos": "left" },
      { "city": "Darwin",    "lon": 130.84, "lat": -12.46, "pos": "below" }
    ]
  },
  "projection": { "type": "mercator", "center": [137, -28], "scale": 1050 },
  "layer": [
    { 
      "data": { "url": "data/aus_states.geojson", "format": { "property": "features" } },
      "mark": { "type": "geoshape", "fill": "#eceae3", "stroke": "#c9c6bc", "strokeWidth": 0.4 }
    },
    {
      "data": { "url": "data/ala_occurrences.csv" },
      "transform": [
        { "filter": "datum.species === species_sel" },
        { "bin": { "step": 0.5 }, "field": "lon", "as": ["lon0", "lon1"] },
        { "bin": { "step": 0.5 }, "field": "lat", "as": ["lat0", "lat1"] },
        { "aggregate": [{ "op": "count", "as": "n" }], "groupby": ["lon0", "lon1", "lat0", "lat1"] }
      ],
      "mark": { "type": "rect", "opacity": 0.85 },
      "encoding": {
        "longitude": { "field": "lon0", "type": "quantitative" },
        "longitude2": { "field": "lon1" },
        "latitude": { "field": "lat0", "type": "quantitative" },
        "latitude2": { "field": "lat1" },
        "color": {
          "field": "n",
          "type": "quantitative",
          "title": "Records per cell (log scale)",
          "scale": { "type": "log", "scheme": "viridis" },
          "legend": { "orient": "bottom", "values": [1, 10, 100, 1000], "format": ",d" }
        },
        "tooltip": [{ "field": "n", "type": "quantitative", "title": "Records in cell" }]
      }
    },
    {
      "data": { "name": "capitals" },
      "mark": { "type": "point", "filled": true, "size": 28, "color": "#0b2e3f", "stroke": "#ffffff", "strokeWidth": 1 },
      "encoding": {
        "longitude": { "field": "lon", "type": "quantitative" },
        "latitude": { "field": "lat", "type": "quantitative" }
      }
    },
    {
      "data": { "name": "capitals" },
      "transform": [{ "filter": "datum.pos === 'right'" }],
      "layer": [
        { "mark": { "type": "text", "align": "left", "baseline": "middle", "dx": 6, "fontSize": 11, "fontWeight": 600, "color": "#fff", "stroke": "#fff", "strokeWidth": 3, "strokeJoin": "round", "strokeOpacity": 0.9 } },
        { "mark": { "type": "text", "align": "left", "baseline": "middle", "dx": 6, "fontSize": 11, "fontWeight": 600, "color": "#0b2e3f" } }
      ],
      "encoding": {
        "longitude": { "field": "lon", "type": "quantitative" },
        "latitude": { "field": "lat", "type": "quantitative" },
        "text": { "field": "city", "type": "nominal" }
      }
    },
    {
      "data": { "name": "capitals" },
      "transform": [{ "filter": "datum.pos === 'left'" }],
      "layer": [
        { "mark": { "type": "text", "align": "right", "baseline": "middle", "dx": -6, "fontSize": 11, "fontWeight": 600, "color": "#fff", "stroke": "#fff", "strokeWidth": 3, "strokeJoin": "round", "strokeOpacity": 0.9 } },
        { "mark": { "type": "text", "align": "right", "baseline": "middle", "dx": -6, "fontSize": 11, "fontWeight": 600, "color": "#0b2e3f" } }
      ],
      "encoding": {
        "longitude": { "field": "lon", "type": "quantitative" },
        "latitude": { "field": "lat", "type": "quantitative" },
        "text": { "field": "city", "type": "nominal" }
      }
    },
    {
      "data": { "name": "capitals" },
      "transform": [{ "filter": "datum.pos === 'above'" }],
      "layer": [
        { "mark": { "type": "text", "align": "center", "baseline": "bottom", "dy": -6, "fontSize": 11, "fontWeight": 600, "color": "#fff", "stroke": "#fff", "strokeWidth": 3, "strokeJoin": "round", "strokeOpacity": 0.9 } },
        { "mark": { "type": "text", "align": "center", "baseline": "bottom", "dy": -6, "fontSize": 11, "fontWeight": 600, "color": "#0b2e3f" } }
      ],
      "encoding": {
        "longitude": { "field": "lon", "type": "quantitative" },
        "latitude": { "field": "lat", "type": "quantitative" },
        "text": { "field": "city", "type": "nominal" }
      }
    },
    {
      "data": { "name": "capitals" },
      "transform": [{ "filter": "datum.pos === 'below'" }],
      "layer": [
        { "mark": { "type": "text", "align": "center", "baseline": "top", "dy": 6, "fontSize": 11, "fontWeight": 600, "color": "#fff", "stroke": "#fff", "strokeWidth": 3, "strokeJoin": "round", "strokeOpacity": 0.9 } },
        { "mark": { "type": "text", "align": "center", "baseline": "top", "dy": 6, "fontSize": 11, "fontWeight": 600, "color": "#0b2e3f" } }
      ],
      "encoding": {
        "longitude": { "field": "lon", "type": "quantitative" },
        "latitude": { "field": "lat", "type": "quantitative" },
        "text": { "field": "city", "type": "nominal" }
      }
    },  
    {
      "data": {
        "url": "data/sua_sightings.csv",
        "format": {
          "type": "csv",
          "parse": {
            "records": "number",
            "lon": "number",
            "lat": "number",
            "is_capital": "boolean"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.species === species_sel && !datum.is_capital && isValid(datum.records) && isValid(datum.lon) && isValid(datum.lat)"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "sua_rank"
            }
          ],
          "sort": [
            {
              "field": "records",
              "order": "descending"
            },
            {
              "field": "sua_code",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.sua_rank <= 3"
        }
      ],
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      },
      "layer": [
        {
          "mark": {
            "type": "point",
            "filled": true,
            "size": 28,
            "color": "#0b2e3f",
            "stroke": "white",
            "strokeWidth": 1
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 11,
            "fontWeight": 600,
            "color": "#fff",
            "stroke": "#fff",
            "strokeWidth": 3,
            "strokeJoin": "round",
            "strokeOpacity": 0.9,
            "dx": 10,
            "align": "left",
            "baseline":"middle"
          },
          "encoding": {
            "text": {
              "field": "label",
              "type": "nominal"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 11,
            "fontWeight": 600,
            "color": "#0b2e3f",
            "dx":10,
            "align": "left",
            "baseline": "middle"
          },
          "encoding": {
            "text": {
              "field": "label",
              "type": "nominal"
            }
          }
        }
      ]
    }

  ]
}
