{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "usermeta": {
    "chapter": 2,
    "advanced": true,
    "idiom": "Ridgeline plot",
    "data": ["data/ala_occurrences.csv"]
  },
  "title": {
    "text": "Warm-water and cold-water species live at different latitudes",
    "subtitle": "Density of sightings by latitude; Latitude runs from southern Tasmania to Cape York."
  },
  "width": 960,
  "height": 65,
  "data": { "url": "data/ala_occurrences.csv" },
  "transform": [
    { "filter": "isValid(datum.lat)" },
    { "density": "lat", "groupby": ["species"], "extent": [-45, -8], "steps": 90 }
  ],
  "mark": {
    "type": "area",
    "interpolate": "monotone",
    "fillOpacity": 0.85,
    "stroke": "#ffffff",
    "strokeWidth": 0.8,
    "fill": "#0e7c86"
  },
  "encoding": {
    "x": { "field": "value", "type": "quantitative", "title": "Latitude (°)", "scale": { "nice": false } },
    "y": { "field": "density", "type": "quantitative", "scale": { "range": [44, -55] }, "axis": null },
    "row": {
      "field": "species",
      "type": "nominal",
      "title": null,
      "header": { "labelAngle": 0, "labelAlign": "left", "labelPadding": 8, "labelFontSize": 12 }
    }
  },
  "config": { "view": { "stroke": null }, "facet": { "spacing": -38 } }
}
