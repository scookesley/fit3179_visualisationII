{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "usermeta": {
    "chapter": 4,
    "advanced": true,
    "idiom": "Parallel coordinates (fold + joinaggregate normalisation)",
    "data": ["data/aims_ltmp_reef_year.csv"],
    "todo": [
      "The AIMS download has hard coral cover only (no soft coral, dead coral or starfish), so the four axes are all built from hard coral: each reef's lowest, average and highest cover since the slider year, and its swing (highest minus lowest).",
      "Only reefs with at least 3 surveys since the slider year are drawn, otherwise 'lowest' and 'highest' mean little. Move the slider right and reefs drop out.",
      "Each axis is rescaled 0-1; the numbers at the top and bottom of each axis show the real max and min.",
      "The headline is a neutral placeholder: replace it with what you see.",
      "If lines are too many to read, filter to one or two sectors or lower the opacity.",
      "Axis order matters in parallel coordinates. Try putting the two variables you want readers to compare next to each other.",
      "If the 'datum' y placement for min/max labels misbehaves in your Vega-Lite version, remove those two text layers and rely on tooltips."
    ]
  },
  "title": {
    "text": "Each reef's coral cover: its low point, average, high point and swing",
    "subtitle": "One line per reef with 3 or more surveys since the chosen year. Axes rescaled to 0-1; labels show the real max (top) and min (bottom), in % cover."
  },
  "width": 960,
  "height": 440,
  "params": [
    {
      "name": "recent_from",
      "value": 2018,
      "bind": { "input": "range", "min": 1986, "max": 2025, "step": 1, "name": "Surveys from year: " }
    }
  ],
  "data": {
    "url": "data/aims_ltmp_reef_year.csv",
    "format": { "type": "csv", "parse": { "year": "number", "hard_coral": "number", "hard_coral_lower": "number", "hard_coral_upper": "number", "lat": "number", "lon": "number" } }
  },
  "transform": [
    { "filter": "datum.year >= recent_from" },
    {
      "aggregate": [
        { "op": "min", "field": "hard_coral", "as": "lowest" },
        { "op": "mean", "field": "hard_coral", "as": "average" },
        { "op": "max", "field": "hard_coral", "as": "highest" },
        { "op": "count", "as": "n_surveys" }
      ],
      "groupby": ["reef", "sector"]
    },
    { "filter": "datum.n_surveys >= 3" },
    { "calculate": "datum.highest - datum.lowest", "as": "swing" },
    { "fold": ["lowest", "average", "highest", "swing"] },
    {
      "joinaggregate": [
        { "op": "min", "field": "value", "as": "min" },
        { "op": "max", "field": "value", "as": "max" }
      ],
      "groupby": ["key"]
    },
    { "calculate": "(datum.value - datum.min) / (datum.max - datum.min)", "as": "norm_val" }
  ],
  "encoding": {
    "x": {
      "field": "key",
      "type": "nominal",
      "sort": ["lowest", "average", "highest", "swing"],
      "title": null,
      "axis": {
        "orient": "top",
        "labelAngle": 0,
        "labelPadding": 14,
        "grid": false,
        "domain": false,
        "ticks": false,
        "labelExpr": "{'lowest':'Lowest cover','average':'Average cover','highest':'Highest cover','swing':'Swing (high - low)'}[datum.value]"
      }
    }
  },
  "layer": [
    {
      "mark": { "type": "rule", "color": "#c5d3da" },
      "encoding": { "detail": { "aggregate": "count" } }
    },
    {
      "mark": { "type": "line", "strokeWidth": 1.4 },
      "encoding": {
        "y": { "field": "norm_val", "type": "quantitative", "axis": null },
        "detail": { "field": "reef", "type": "nominal" },
        "color": { "field": "sector", "type": "nominal", "title": "Sector (north to south)", "scale": { "scheme": "tableau20", "domain": ["Torres Strait", "Cape Grenville", "Princess Charlotte Bay", "Cooktown-Lizard Island", "Cairns", "Innisfail", "Townsville", "Cape Upstart", "Whitsunday", "Pompey", "Swain", "Capricorn-Bunker"] } },
        "opacity": { "value": 0.45 },
        "tooltip": [
          { "field": "reef", "type": "nominal", "title": "Reef" },
          { "field": "sector", "type": "nominal", "title": "Sector" },
          { "field": "key", "type": "nominal", "title": "Measure" },
          { "field": "value", "type": "quantitative", "title": "Hard coral (% cover)", "format": ".1f" },
          { "field": "n_surveys", "type": "quantitative", "title": "Surveys" }
        ]
      }
    },
    {
      "mark": { "type": "text", "baseline": "bottom", "dy": -3, "fontSize": 10, "color": "#3d4f5c" },
      "encoding": {
        "y": { "datum": 1, "type": "quantitative" },
        "text": { "aggregate": "max", "field": "max", "type": "quantitative", "format": ".1f" }
      }
    },
    {
      "mark": { "type": "text", "baseline": "top", "dy": 3, "fontSize": 10, "color": "#3d4f5c" },
      "encoding": {
        "y": { "datum": 0, "type": "quantitative" },
        "text": { "aggregate": "min", "field": "min", "type": "quantitative", "format": ".1f" }
      }
    }
  ]
}
